post_install() {
  echo ">>> Set LOCK_LOGGER_USER in /etc/conf.d/lock-input-logger, then run:"
  echo ">>>   systemctl enable --now lock-input-logger"
}

post_upgrade() {
  systemctl daemon-reload
  systemctl try-restart lock-input-logger.service
}

pre_remove() {
  systemctl disable --now lock-input-logger.service 2>/dev/null || true
}
