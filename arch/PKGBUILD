pkgname=lock-input-logger
pkgver=0.1.0
pkgrel=1
pkgdesc='Log which input devices are active while the session is locked'
arch=('x86_64')
license=('unknown')
depends=('gcc-libs' 'glibc' 'systemd')
makedepends=('cargo')
backup=('etc/conf.d/lock-input-logger')
install=lock-input-logger.install
source=()

_project="$startdir/.."

prepare() {
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --manifest-path "$_project/Cargo.toml" --target "$(rustc --print host-tuple)"
}

build() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release --manifest-path "$_project/Cargo.toml"
}

check() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release --manifest-path "$_project/Cargo.toml"
}

package() {
  install -Dm755 "$srcdir/target/release/lock-input-logger" "$pkgdir/usr/bin/lock-input-logger"
  install -Dm644 "$startdir/lock-input-logger.service" "$pkgdir/usr/lib/systemd/system/lock-input-logger.service"
  install -Dm644 "$startdir/lock-input-logger.conf" "$pkgdir/etc/conf.d/lock-input-logger"
}
